# Model weights are binary and large: keep them out of the git object store.
# yolov8m-pose.onnx alone is 101 MB, over GitHub's 100 MB per-file hard limit,
# so LFS is required rather than merely tidy.
*.pt      filter=lfs diff=lfs merge=lfs -text
*.onnx    filter=lfs diff=lfs merge=lfs -text
*.tfl     filter=lfs diff=lfs merge=lfs -text
*.tflite  filter=lfs diff=lfs merge=lfs -text
*.hef     filter=lfs diff=lfs merge=lfs -text
*.npy     filter=lfs diff=lfs merge=lfs -text
